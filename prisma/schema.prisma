// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  role UserRole

  createdAt DateTime @default(now())

  //Relations
  memberships TeamMember[]
  stats PlayerStatistic[]
  teamsCreated Teams[] @relation("TeamCreator")
  leaguesCreated League[] @relation("LeagueCreator")
  matchesCreated Match[] @relation("MatchCreator")
}

model Teams {
  id String @id @default(uuid())
  name String
  city String 
  logo String?

  createdBy String
  createdAt DateTime @default(now())
  //Relations
  creator User @relation("TeamCreator",fields: [createdBy], references: [id])
  members TeamMember[]
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

}

model League {
  id String @id @default(uuid())
  name String 
  season String

  createdBy String
  createdAt DateTime @default(now())

  //Relations
  creator User @relation("LeagueCreator",fields: [createdBy], references: [id])
}

model Match {
  id String @id @default(uuid())
  homeTeamId String 
  awayTeamId String 
  homeScore Int?
  awayScore Int?
  status MatchStatus
  matchDate DateTime

  createdBy String
  createdAt DateTime @default(now())

  //Relations
  creator User @relation("MatchCreator",fields: [createdBy], references: [id])
  homeTeam Teams @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Teams @relation("AwayTeam",fields: [awayTeamId], references: [id])
}

model TeamMember {
  id String @id @default(uuid())

  userId String
  teamId String

  playerPosition Position
  jerseyNumber Int
  captain Boolean @default(false)
  viceCaptain Boolean @default(false)

  joinedDate DateTime @default(now())

  //Relations
  user User @relation(fields: [userId], references: [id])
  team Teams @relation(fields: [teamId], references: [id])
}

model PlayerStatistic {
  id String @id @default(uuid())
  playerId String
  goals Int @default(0)
  assists Int @default(0)

    createdAt DateTime @default(now())
    player User @relation(fields: [playerId], references: [id])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum UserRole {
  ADMIN
  ORGANISER
  COACH
  PLAYER
}

enum Position {
  GK

  RB
  RWB
  
  CB
  LCB
  RCB

  LB
  LWB

  CDM
  CM
  CAM

  RW
  LW

  CF
  ST
}
